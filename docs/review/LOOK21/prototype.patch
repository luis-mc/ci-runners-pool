new file mode 100644
index 0000000..281c237
--- /dev/null
+++ b/apps/web/src/screens/lookProto.tsx
@@ -0,0 +1,262 @@
+// LOOK21 review prototype. NOT committed to the app: it lives in docs/review/LOOK21/prototype.patch.
+// ?v=a sticky bar, ?v=b save at once, ?v=c top and bottom bar with a leave guard. No ?v is today's page.
+import { Button, FormActions, QuestionCard } from '@crsp/ui';
+import { useEffect, useRef, useState, type ReactNode } from 'react';
+import { useNavigate } from 'react-router-dom';
+
+export type Variant = 'base' | 'a' | 'b' | 'c';
+export const variant = (): Variant => {
+  const v = new URLSearchParams(window.location.search).get('v');
+  return v === 'a' || v === 'b' || v === 'c' ? v : 'base';
+};
+
+const same = (a: unknown, b: unknown) => JSON.stringify(a) === JSON.stringify(b);
+
+const recent = new Map<string, { at: number; before: unknown }>();
+const SHOWN = 7000;
+
+/** A: a bar on the left of a changed field. B: a short "Saved" with Undo after the field changes. */
+export function Mark({
+  id,
+  value,
+  base,
+  onUndo,
+  children,
+}: {
+  id: string;
+  value: unknown;
+  base: unknown;
+  onUndo: (previous: never) => void;
+  children: ReactNode;
+}) {
+  const v = variant();
+  const prev = useRef(value);
+  const [, tick] = useState(0);
+  useEffect(() => {
+    if (v !== 'b' || same(prev.current, value)) return;
+    recent.set(id, { at: Date.now(), before: prev.current });
+    prev.current = value;
+    tick((n) => n + 1);
+    const a = setTimeout(() => tick((n) => n + 1), 900);
+    const b = setTimeout(() => tick((n) => n + 1), SHOWN);
+    return () => {
+      clearTimeout(a);
+      clearTimeout(b);
+    };
+  }, [value, v, id]);
+  const r = recent.get(id);
+  const age = r ? Date.now() - r.at : Infinity;
+  const chip = age < 900 ? 'saving' : age < SHOWN ? 'saved' : undefined;
+  if (v === 'a' && !same(value, base))
+    return (
+      <div
+        data-changed
+        style={{
+          borderLeft: '4px solid var(--ds-color-needs-you)',
+          paddingLeft: 'var(--ds-space-3)',
+        }}
+      >
+        {children}
+      </div>
+    );
+  if (v === 'b')
+    return (
+      <div>
+        {children}
+        {chip ? (
+          <div style={{ marginTop: 4, color: 'var(--ds-color-done)' }} role="status">
+            {chip === 'saving' ? 'Saving…' : '✓ Saved'}{' '}
+            {chip === 'saved' ? (
+              <Button
+                onPress={() => {
+                  prev.current = r?.before;
+                  recent.delete(id);
+                  onUndo(r?.before as never);
+                  tick((n) => n + 1);
+                }}
+              >
+                Undo
+              </Button>
+            ) : null}
+          </div>
+        ) : null}
+      </div>
+    );
+  return <>{children}</>;
+}
+
+/** B: send the form once the value rests for a moment. Risky changes still reach the page's own question. */
+export function useAutosave(dirty: boolean, key: string, send: () => void) {
+  const sendRef = useRef(send);
+  sendRef.current = send;
+  useEffect(() => {
+    if (variant() !== 'b' || !dirty) return;
+    const t = setTimeout(() => sendRef.current(), 600);
+    return () => clearTimeout(t);
+  }, [dirty, key]);
+}
+
+/** C: ask before leaving a form with changes. */
+export function useLeaveGuard(dirty: boolean): ReactNode {
+  const navigate = useNavigate();
+  const [href, setHref] = useState<string | undefined>(undefined);
+  useEffect(() => {
+    if (variant() !== 'c' || !dirty) return;
+    const click = (e: MouseEvent) => {
+      const a = (e.target as HTMLElement).closest('a');
+      const to = a?.getAttribute('href');
+      if (!a || !to || !to.startsWith('/') || to === window.location.pathname) return;
+      e.preventDefault();
+      e.stopPropagation();
+      setHref(to);
+    };
+    const unload = (e: BeforeUnloadEvent) => e.preventDefault();
+    document.addEventListener('click', click, true);
+    window.addEventListener('beforeunload', unload);
+    return () => {
+      document.removeEventListener('click', click, true);
+      window.removeEventListener('beforeunload', unload);
+    };
+  }, [dirty]);
+  if (href === undefined) return null;
+  return (
+    <QuestionCard
+      title="Discard changes?"
+      items={['Your changes on this page are not saved.']}
+      action="Discard"
+      busyLabel="Leaving"
+      busy={false}
+      onCancel={() => setHref(undefined)}
+      onConfirm={() => {
+        setHref(undefined);
+        void navigate(href);
+      }}
+    />
+  );
+}
+
+export interface SaveProps {
+  busy: boolean;
+  disabled?: boolean | undefined;
+  reason?: string | undefined;
+  kind?: 'primary' | 'default';
+}
+
+/** C only: Save and Cancel at the top of the form, disabled until something changes. */
+export function TopBar({
+  count,
+  onRevert,
+  save,
+}: {
+  count: number;
+  onRevert: () => void;
+  save: SaveProps;
+}) {
+  if (variant() !== 'c') return null;
+  return (
+    <FormActions>
+      <Button disabled={count === 0} onPress={onRevert}>
+        Cancel
+      </Button>
+      <Button
+        kind="primary"
+        submit
+        busy={save.busy}
+        busyLabel="Saving"
+        disabled={count === 0 || save.disabled}
+        reason={count === 0 ? 'Nothing changed yet.' : save.reason}
+      >
+        Save
+      </Button>
+    </FormActions>
+  );
+}
+
+/** The bottom of the form: today's pair, the sticky bar (A), nothing (B), or the pair disabled until a change (C). */
+export function BottomBar({
+  count,
+  onRevert,
+  save,
+  today,
+}: {
+  count: number;
+  onRevert: () => void;
+  save: SaveProps;
+  today: ReactNode;
+}) {
+  const v = variant();
+  if (v === 'base') return <>{today}</>;
+  if (v === 'b') return null;
+  if (v === 'c')
+    return (
+      <FormActions>
+        <Button disabled={count === 0} onPress={onRevert}>
+          Cancel
+        </Button>
+        <Button
+          kind="primary"
+          submit
+          busy={save.busy}
+          busyLabel="Saving"
+          disabled={count === 0 || save.disabled}
+          reason={count === 0 ? 'Nothing changed yet.' : save.reason}
+        >
+          Save
+        </Button>
+      </FormActions>
+    );
+  return <StickyBar count={count} onRevert={onRevert} save={save} />;
+}
+
+function StickyBar({
+  count,
+  onRevert,
+  save,
+}: {
+  count: number;
+  onRevert: () => void;
+  save: SaveProps;
+}) {
+  // The key-hint bar is fixed at the window foot on a mouse screen: sit just above it.
+  const [lift, setLift] = useState(0);
+  useEffect(() => {
+    const k = document.querySelector('.ds-keyhints');
+    setLift(k && getComputedStyle(k).display !== 'none' ? k.getBoundingClientRect().height : 0);
+  }, []);
+  if (count === 0) return null;
+  return (
+    <div
+      data-sticky-bar
+      role="region"
+      aria-label="Unsaved changes"
+      style={{
+        position: 'sticky',
+        bottom: lift,
+        zIndex: 5,
+        background: 'var(--ds-color-surface)',
+        borderTop: '2px solid var(--ds-color-needs-you)',
+        padding: 'var(--ds-space-3)',
+        display: 'flex',
+        flexWrap: 'wrap',
+        alignItems: 'center',
+        justifyContent: 'space-between',
+        gap: 'var(--ds-space-3)',
+      }}
+    >
+      <strong>{`Unsaved changes (${count})`}</strong>
+      <FormActions>
+        <Button onPress={onRevert}>Cancel</Button>
+        <Button
+          kind="primary"
+          submit
+          busy={save.busy}
+          busyLabel="Saving"
+          disabled={save.disabled}
+          reason={save.reason}
+        >
+          Save
+        </Button>
+      </FormActions>
+    </div>
+  );
+}
