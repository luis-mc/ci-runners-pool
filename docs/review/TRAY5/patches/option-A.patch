index 0000000..4d61000
--- /dev/null
+++ b/apps/web/src/proto/Chrome.tsx
@@ -0,0 +1,34 @@
+// TRAY5 prototype only (never committed to app code): the window chrome shared by the updater and the installer.
+import { useEffect, useState, type ReactNode } from 'react';
+
+export const OPT: 'A' | 'B' | 'C' = 'A' as 'A';
+
+export function Proto({ title, children }: { title: string; children: ReactNode }) {
+  const [sub, setSub] = useState('');
+  useEffect(() => {
+    document.title = `${title} - CI Runners Shared Pool`;
+    const read = () => {
+      const items = Array.from(document.querySelectorAll('.ds-steps__item'));
+      const i = items.findIndex((li) => li.getAttribute('data-standing') === 'now');
+      if (i >= 0)
+        setSub(`Step ${i + 1} of ${items.length}: ${(items[i]?.textContent ?? '').replace(/^[✓\d]+\s*/, '').trim()}`);
+    };
+    read();
+    const mo = new MutationObserver(read);
+    mo.observe(document.body, { subtree: true, attributes: true, childList: true });
+    return () => mo.disconnect();
+  }, [title]);
+  return (
+    <div className="proto" data-proto={OPT}>
+      <header className="proto-head">
+        <img src="/crsp-icon.png" alt="" width={32} height={32} />
+        <div className="proto-head__text">
+          <b className="proto-name">CI Runners Shared Pool</b>
+          <span className="proto-title">{title}</span>
+          <span className="proto-sub">{sub}</span>
+        </div>
+      </header>
+      {children}
+    </div>
+  );
+}
diff --git a/apps/web/src/proto/Installer.tsx b/apps/web/src/proto/Installer.tsx
new file mode 100644
index 0000000..ce56524
--- /dev/null
+++ b/apps/web/src/proto/Installer.tsx
@@ -0,0 +1,72 @@
+// TRAY5 prototype only: the installer window as the same shared wizard (welcome, choices, installing, done, failed).
+import { Facts, Message, Stack, Switch, Text, Wizard, type WizardPhase } from '@crsp/ui';
+import { useState } from 'react';
+import { useSearchParams } from 'react-router-dom';
+import { OPT, Proto } from './Chrome';
+
+const STEPS = OPT === 'B' ? ['Welcome', 'Choices', 'Install', 'Done'] : ['Welcome', 'Choices', 'Installing', 'Done'];
+const noop = () => undefined;
+
+export function InstallerPage() {
+  const [params] = useSearchParams();
+  const state = params.get('state') ?? 'welcome';
+  const [tray, setTray] = useState(true);
+  const [open, setOpen] = useState(true);
+  const phase: WizardPhase =
+    state === 'installing' ? 'running' : state === 'done' ? 'done' : state === 'failed' ? 'failed' : 'ready-to-review';
+  const current = state === 'welcome' ? 0 : state === 'choices' ? 1 : state === 'done' ? 3 : 2;
+  let body;
+  if (state === 'welcome')
+    body = (
+      <Stack>
+        <Text>Install CI Runners Shared Pool 0.1.12 on this PC.</Text>
+        <Text>It adds the crsp service, the tray icon and a Start menu shortcut. Your data stays.</Text>
+      </Stack>
+    );
+  else if (state === 'choices')
+    body = (
+      <Stack>
+        <Facts items={[{ name: 'Install folder', value: 'C:\\Program Files\\crsp' }]} />
+        <Switch label="Start the tray when I sign in" on={tray} onChange={setTray} />
+        <Switch label="Open the console when done" on={open} onChange={setOpen} />
+      </Stack>
+    );
+  else if (state === 'installing') body = <Text>Running jobs are not affected. Nothing else to do.</Text>;
+  else if (state === 'failed')
+    body = (
+      <Message tone="problem">
+        The install did not finish. The installer stopped with code 1603. Nothing was changed. The log is
+        C:\ProgramData\crsp\logs\msi-install.log. Then try again.
+      </Message>
+    );
+  else
+    body = (
+      <Stack>
+        <Message tone="done">Now running 0.1.12.</Message>
+        <Facts items={[{ name: 'Version', value: '0.1.12' }, { name: 'Service', value: 'running' }]} />
+      </Stack>
+    );
+  return (
+    <Proto title="Setup">
+      <main>
+        <div className="ds-page" data-frame="compact">
+          <Wizard
+            name="Setup"
+            steps={STEPS}
+            current={current}
+            firstStep={-1}
+            phase={phase}
+            progress={phase === 'running' ? { text: 'Installing 60%', value: 60, max: 100 } : undefined}
+            onBack={noop}
+            backLabel={state === 'welcome' ? 'Cancel' : state === 'done' || state === 'failed' ? 'Close' : 'Back'}
+            primary={{ label: state === 'welcome' ? 'Next' : 'Install', busyLabel: 'Installing', onPress: noop }}
+            donePrimary={{ label: 'Open the console', onPress: noop }}
+            onTryAgain={noop}
+          >
+            {body}
+          </Wizard>
+        </div>
+      </main>
+    </Proto>
+  );
+}
diff --git a/apps/web/src/proto/proto.css b/apps/web/src/proto/proto.css
new file mode 100644
index 0000000..6ccf58b
--- /dev/null
+++ b/apps/web/src/proto/proto.css
@@ -0,0 +1,25 @@
+/* Option A: compact fixed dialog, close only. Steps are a vertical list on the left; content fills the window. */
+html, body { margin: 0; block-size: 100%; overflow: hidden; }
+.proto[data-proto='A'] { block-size: 100vh; position: relative; background: var(--ds-color-page); }
+.proto[data-proto='A'] main, .proto[data-proto='A'] .ds-page { block-size: 100%; max-inline-size: none; margin: 0; padding: 0; display: block; }
+.proto[data-proto='A'] .ds-wizard { block-size: 100vh; box-sizing: border-box; gap: 0; display: grid;
+  grid-template-columns: 200px 1fr; grid-template-rows: 1fr auto; }
+.proto[data-proto='A'] .ds-steps { grid-column: 1; grid-row: 1 / span 2; display: flex; flex-direction: column; flex-wrap: nowrap; gap: 0;
+  padding: 76px 0 0; background: var(--ds-color-surface); border-inline-end: 1px solid var(--ds-color-divider); }
+.proto[data-proto='A'] .ds-steps__item { display: block; }
+.proto[data-proto='A'] .ds-steps__button { inline-size: 100%; text-align: start; min-block-size: 36px; border: 0; padding-inline: 16px; border-inline-start: 3px solid transparent; font-size: var(--ds-size-2); }
+.proto[data-proto='A'] .ds-steps__item[data-standing='now'] .ds-steps__button { border-inline-start-color: var(--ds-color-primary); background: var(--ds-color-selection); }
+.proto[data-proto='A'] .ds-wizard__body { grid-column: 2; grid-row: 1; padding: 72px 20px 12px; align-content: start; overflow: auto; }
+.proto[data-proto='A'] .ds-action-bar { grid-column: 2; grid-row: 2; position: static; padding: 12px 20px; }
+.proto[data-proto='A'] .proto-head { position: absolute; inset-block-start: 0; inset-inline-start: 0; inline-size: 100%; pointer-events: none; z-index: 2; }
+.proto[data-proto='A'] .proto-head img { position: absolute; inset-block-start: 16px; inset-inline-start: 16px; }
+.proto[data-proto='A'] .proto-head__text { display: block; }
+.proto[data-proto='A'] .proto-name { position: absolute; inset-block-start: 14px; inset-inline-start: 56px; inline-size: 130px; font-size: var(--ds-size-1); line-height: 1.2; color: var(--ds-color-text); }
+.proto[data-proto='A'] .proto-title { position: absolute; inset-block-start: 20px; inset-inline-start: 220px; font-size: var(--ds-size-5); font-weight: 700; color: var(--ds-color-text); }
+.proto[data-proto='A'] .proto-sub { display: none; }
+/* The window is under 600 px wide, but it is a desktop window: keep the bar on one row (the phone layout of the web page does not apply). */
+.proto[data-proto='A'] .ds-action-bar { flex-direction: row; align-items: center; flex-wrap: nowrap; }
+.proto[data-proto='A'] .ds-action-bar__side, .proto[data-proto='A'] .ds-action-bar__main { flex-direction: row; align-items: center; }
+.proto[data-proto='A'] .ds-action-bar > :first-child { margin-inline-start: auto; }
+.proto[data-proto='A'] .ds-action-bar .ds-button-wrap, .proto[data-proto='A'] .ds-action-bar .ds-button { inline-size: auto; }
+.proto[data-proto='A'] .ds-action-bar__side { order: 0; } .proto[data-proto='A'] .ds-action-bar__main { order: 1; }
