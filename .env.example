# Key names and descriptions only. Copy to .env.local and set real values.
# A value that looks like a placeholder (<...>, changeme, your-...) is refused
# at startup (STACKSPEC 15), so leave a key unset to use its default.
#
# The GitHub App private key and the webhook secret are NOT configuration.
# They live in the OS secret store, never in env, the database or logs.

# Directory for the SQLite database and local state. Absolute path.
# Default: <user config dir>/ci-runners-pool
CRP_DATA_DIR=

# Controller HTTP listen address, host:port.
# Default: 127.0.0.1:8080
CRP_LISTEN_ADDR=

# Minimum log level: debug, info, warn, error.
# Default: info
CRP_LOG_LEVEL=
